{
  "name": "Scan-to-World",
  "short_name": "Scan-to-World",
  "description": "A scanned object becomes a world drawn like an old map. Sow people, farms and woods with a tap, and turn it to watch them grow.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#f4efe4",
  "theme_color": "#f4efe4",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "scan",
          "accept": ["model/gltf-binary", "model/gltf+json", "model/obj", "model/ply", "application/octet-stream", ".glb", ".gltf", ".obj", ".ply"]
        }
      ]
    }
  }
}
